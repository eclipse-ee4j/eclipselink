<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.ee4j</groupId>
        <artifactId>project</artifactId>
        <version>2.0.3</version>
        <relativePath/>
    </parent>

    <groupId>org.eclipse.persistence</groupId>
    <artifactId>eclipselink-tck</artifactId>
    <version>6.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>EclipseLink Jakarta Persistence TCK</name>

    <!--
        Runs the Jakarta Persistence TCK against EclipseLink straight from Maven.

        Deliberately not a module of the EclipseLink reactor: it needs a database and
        takes minutes, so a plain "mvn install" at the root should not drag it in. Build
        it by changing into this directory.

            cd tck
            mvn clean install -Ppostgres-start,test1,test2

        The EclipseLink under test is whatever ${eclipselink.version} resolves to, so
        this runs against a released version just as happily as against the local
        snapshot:

            mvn clean install -Ppostgres-start,test1,test2 -Declipselink.version=5.0.0

        The predecessor of this runner unpacked a whole GlassFish distribution, copied
        the EclipseLink jars over the top of the ones inside it, and then pointed the
        test classpath at that directory. GlassFish was never started - it served only
        as an archive of jars. Everything it supplied is available from Maven, so this
        runner resolves it directly and the distribution is gone.
    -->
    <modules>
        <module>eclipselink-tck-install</module>
        <module>eclipselink-tck-run</module>
        <module>hibernate-tck-run</module>
    </modules>
</project>
