<!-- Replaces the ejb-jar.xml eclipselink-testbuild-plugin would generate, adding the java:app names
     below. A persistence unit defined in an EJB jar is only visible inside that jar, so the composite
     module cannot reference this member unit itself; declaring the references here, where it is
     visible, binds them in the application namespace, where the test runner of the composite module
     finds them (see JEEPlatform.getEntityManagerFactory). -->
<ejb-jar xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
          https://jakarta.ee/xml/ns/jakartaee/ejb-jar_4_0.xsd"
         version="4.0">
    <enterprise-beans>
        <session>
            <ejb-name>SingleUnitTestRunner</ejb-name>
            <persistence-context-ref>
                <persistence-context-ref-name>persistence/composite-advanced-member_1/entity-manager</persistence-context-ref-name>
                <persistence-unit-name>composite-advanced-member_1</persistence-unit-name>
            </persistence-context-ref>
            <persistence-context-ref>
                <persistence-context-ref-name>java:app/persistence/composite-advanced-member_1/entity-manager</persistence-context-ref-name>
                <persistence-unit-name>composite-advanced-member_1</persistence-unit-name>
            </persistence-context-ref>
            <persistence-unit-ref>
                <persistence-unit-ref-name>persistence/composite-advanced-member_1/factory</persistence-unit-ref-name>
                <persistence-unit-name>composite-advanced-member_1</persistence-unit-name>
            </persistence-unit-ref>
            <persistence-unit-ref>
                <persistence-unit-ref-name>java:app/persistence/composite-advanced-member_1/factory</persistence-unit-ref-name>
                <persistence-unit-name>composite-advanced-member_1</persistence-unit-name>
            </persistence-unit-ref>
        </session>
        <session>
            <ejb-name>GenericTestRunner</ejb-name>
            <persistence-context-ref>
                <persistence-context-ref-name>persistence/composite-advanced-member_1/entity-manager</persistence-context-ref-name>
                <persistence-unit-name>composite-advanced-member_1</persistence-unit-name>
            </persistence-context-ref>
            <persistence-unit-ref>
                <persistence-unit-ref-name>persistence/composite-advanced-member_1/factory</persistence-unit-ref-name>
                <persistence-unit-name>composite-advanced-member_1</persistence-unit-name>
            </persistence-unit-ref>
        </session>
    </enterprise-beans>
</ejb-jar>
