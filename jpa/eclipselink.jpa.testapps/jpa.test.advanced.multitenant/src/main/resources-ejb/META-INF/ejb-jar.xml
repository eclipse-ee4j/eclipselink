<!-- Replaces the ejb-jar.xml eclipselink-testbuild-plugin would generate from the Java SE persistence.xml,
     leaving out multi-tenant-vpd, which the server-side persistence.xml does not define (see there). -->
<ejb-jar version="4.0" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/ejb-jar_4_0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://jakarta.ee/xml/ns/jakartaee">
    <enterprise-beans>
        <session>
            <ejb-name>GenericTestRunner</ejb-name>
            <persistence-context-ref>
                <persistence-context-ref-name>persistence/multi-tenant-shared-emf/entity-manager</persistence-context-ref-name>
                <persistence-unit-name>multi-tenant-shared-emf</persistence-unit-name>
            </persistence-context-ref>
            <persistence-context-ref>
                <persistence-context-ref-name>persistence/multi-tenant-123/entity-manager</persistence-context-ref-name>
                <persistence-unit-name>multi-tenant-123</persistence-unit-name>
            </persistence-context-ref>
            <persistence-context-ref>
                <persistence-context-ref-name>persistence/multi-tenant-table-per-tenant/entity-manager</persistence-context-ref-name>
                <persistence-unit-name>multi-tenant-table-per-tenant</persistence-unit-name>
            </persistence-context-ref>
            <persistence-context-ref>
                <persistence-context-ref-name>persistence/multi-tenant-table-per-tenant-C/entity-manager</persistence-context-ref-name>
                <persistence-unit-name>multi-tenant-table-per-tenant-C</persistence-unit-name>
            </persistence-context-ref>
            <persistence-context-ref>
                <persistence-context-ref-name>persistence/multi-tenant-schema-per-tenant/entity-manager</persistence-context-ref-name>
                <persistence-unit-name>multi-tenant-schema-per-tenant</persistence-unit-name>
            </persistence-context-ref>
            <persistence-unit-ref>
                <persistence-unit-ref-name>persistence/multi-tenant-shared-emf/factory</persistence-unit-ref-name>
                <persistence-unit-name>multi-tenant-shared-emf</persistence-unit-name>
            </persistence-unit-ref>
            <persistence-unit-ref>
                <persistence-unit-ref-name>persistence/multi-tenant-123/factory</persistence-unit-ref-name>
                <persistence-unit-name>multi-tenant-123</persistence-unit-name>
            </persistence-unit-ref>
            <persistence-unit-ref>
                <persistence-unit-ref-name>persistence/multi-tenant-table-per-tenant/factory</persistence-unit-ref-name>
                <persistence-unit-name>multi-tenant-table-per-tenant</persistence-unit-name>
            </persistence-unit-ref>
            <persistence-unit-ref>
                <persistence-unit-ref-name>persistence/multi-tenant-table-per-tenant-C/factory</persistence-unit-ref-name>
                <persistence-unit-name>multi-tenant-table-per-tenant-C</persistence-unit-name>
            </persistence-unit-ref>
            <persistence-unit-ref>
                <persistence-unit-ref-name>persistence/multi-tenant-schema-per-tenant/factory</persistence-unit-ref-name>
                <persistence-unit-name>multi-tenant-schema-per-tenant</persistence-unit-name>
            </persistence-unit-ref>
        </session>
    </enterprise-beans>
</ejb-jar>
