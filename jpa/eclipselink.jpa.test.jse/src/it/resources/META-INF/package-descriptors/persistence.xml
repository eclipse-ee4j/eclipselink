<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_4_0.xsd"
        version="4.0">
    <persistence-unit name="package-descriptors-xml" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <class>org.eclipse.persistence.jpa.packagedescriptors.model.PackageModels$Record</class>
        <class>org.eclipse.persistence.jpa.packagedescriptors.model.PackageModels$DiscoveredListener</class>
        <package-descriptor>org.eclipse.persistence.jpa.packagedescriptors.model</package-descriptor>
        <package-descriptor>org.eclipse.persistence.jpa.packagedescriptors.metadata</package-descriptor>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
    </persistence-unit>
</persistence>
