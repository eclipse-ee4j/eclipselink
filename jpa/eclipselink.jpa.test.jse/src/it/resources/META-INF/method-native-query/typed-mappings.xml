<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm" version="4.0">
    <named-native-query name="methodNative.xmlMapped" result-set-mapping="methodNative.xmlReordered">
        <query>SELECT TITLE AS BOOK_TITLE, ID AS BOOK_ID FROM JPA_METHOD_NATIVE_BOOK ORDER BY ID</query>
    </named-native-query>
    <sql-result-set-mapping name="methodNative.xmlReordered">
        <constructor-result target-class="org.eclipse.persistence.jpa.test.query.methodnative.MethodNativeResults$Summary">
            <column name="BOOK_ID" class="java.lang.Integer"/>
            <column name="BOOK_TITLE" class="java.lang.String"/>
        </constructor-result>
    </sql-result-set-mapping>
</entity-mappings>
