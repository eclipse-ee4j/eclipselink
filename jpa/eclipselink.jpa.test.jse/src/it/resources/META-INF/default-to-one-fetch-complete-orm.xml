<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_4_0.xsd"
        version="4.0">
    <mapped-superclass class="org.eclipse.persistence.jpa.fetchdefaults.model.DefaultFetchMappedSuperclass"
            access="PROPERTY" metadata-complete="true">
        <attributes>
            <id name="id"/>
            <many-to-one name="inheritedTarget">
                <join-column name="INHERITED_ID"/>
            </many-to-one>
        </attributes>
    </mapped-superclass>
    <entity class="org.eclipse.persistence.jpa.fetchdefaults.model.DefaultFetchPropertyOwner"
            access="PROPERTY" metadata-complete="true">
        <table name="JPA_DTF_PROPERTY"/>
        <attributes>
            <many-to-one name="many">
                <join-column name="MANY_ID"/>
            </many-to-one>
            <one-to-one name="one">
                <join-column name="ONE_ID"/>
            </one-to-one>
        </attributes>
    </entity>
</entity-mappings>
