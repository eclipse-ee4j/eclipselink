<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm" version="4.0">
    <named-query name="EANamed.xmlExtended">
        <query>select r from AgentNamedOptionsRecord r where r.id=1</query>
        <lock-mode>PESSIMISTIC_WRITE</lock-mode>
        <lock-scope>EXTENDED</lock-scope>
    </named-query>
    <named-query name="EANamed.xmlScopeHint">
        <query>select r from AgentNamedOptionsRecord r where r.id=1</query>
        <lock-mode>PESSIMISTIC_WRITE</lock-mode>
        <lock-scope>EXTENDED</lock-scope>
        <hint name="jakarta.persistence.lock.scope" value="NORMAL"/>
    </named-query>
    <named-query name="EANamed.xmlGraph">
        <query>select r from AgentNamedOptionsRecord r where r.id=1</query>
        <entity-graph>EANamed.tags</entity-graph>
    </named-query>
    <named-query name="EANamed.xmlGraphHint">
        <query>select r from AgentNamedOptionsRecord r where r.id=1</query>
        <hint name="jakarta.persistence.loadgraph" value="EANamed.notes"/>
        <entity-graph>EANamed.tags</entity-graph>
    </named-query>
</entity-mappings>
