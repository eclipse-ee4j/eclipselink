<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm" version="4.0">
    <persistence-unit-metadata><xml-mapping-metadata-complete/></persistence-unit-metadata>
    <named-native-query name="methodNativeManaged.xmlOnly" result-class="java.lang.String">
        <query>SELECT DETAIL_TEXT FROM JPA_METHOD_NATIVE_DISCOVERY WHERE ID = ?1</query>
    </named-native-query>
    <mapped-superclass class="org.eclipse.persistence.jpa.test.query.methodnative.discovery.MethodNativeDiscoveryBase" access="FIELD"/>
    <entity class="org.eclipse.persistence.jpa.test.query.methodnative.discovery.MethodNativeDiscoveryOwner"
            name="MethodNativeDiscoveryOwner" access="FIELD">
        <table name="JPA_METHOD_NATIVE_DISCOVERY"/>
        <attributes>
            <id name="id"><column name="ID"/></id>
            <embedded name="detail"/>
            <embedded name="otherDetail"/>
        </attributes>
    </entity>
    <embeddable class="org.eclipse.persistence.jpa.test.query.methodnative.discovery.MethodNativeDiscoveryDetail" access="FIELD">
        <attributes><basic name="text"><column name="DETAIL_TEXT"/></basic></attributes>
    </embeddable>
    <embeddable class="org.eclipse.persistence.jpa.test.query.methodnative.discovery.MethodNativeDiscoveryOtherDetail" access="FIELD">
        <attributes><basic name="text"><column name="OTHER_TEXT"/></basic></attributes>
    </embeddable>
</entity-mappings>
