<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm" version="4.0">
    <persistence-unit-metadata>
        <xml-mapping-metadata-complete/>
    </persistence-unit-metadata>
    <mapped-superclass class="org.eclipse.persistence.jpa.test.basic.model.nonnull.NonnullXmlBase" access="FIELD">
        <attributes>
            <basic name="inheritedValue"/>
        </attributes>
    </mapped-superclass>
    <embeddable class="org.eclipse.persistence.jpa.test.basic.model.nonnull.NonnullXmlDetails" access="FIELD">
        <attributes>
            <basic name="detailValue"/>
            <basic name="nullableValue"/>
        </attributes>
    </embeddable>
    <entity class="org.eclipse.persistence.jpa.test.basic.model.nonnull.NonnullXmlOwner" access="FIELD">
        <table name="NNOPT_XML"/>
        <attributes>
            <id name="id"/>
            <basic name="basicTrue" optional="true"/>
            <basic name="basicFalse" optional="false"/>
            <basic name="basicOmitted"/>
            <basic name="annotationOnly"/>
            <many-to-one name="manyTrue" optional="true" target-entity="org.eclipse.persistence.jpa.test.basic.model.nonnull.NonnullTarget">
                <join-column name="MANY_TRUE"/>
            </many-to-one>
            <many-to-one name="manyFalse" optional="false" target-entity="org.eclipse.persistence.jpa.test.basic.model.nonnull.NonnullTarget">
                <join-column name="MANY_FALSE"/>
            </many-to-one>
            <one-to-one name="oneTrue" optional="true" target-entity="org.eclipse.persistence.jpa.test.basic.model.nonnull.NonnullTarget">
                <join-column name="ONE_TRUE"/>
            </one-to-one>
            <one-to-one name="oneFalse" optional="false" target-entity="org.eclipse.persistence.jpa.test.basic.model.nonnull.NonnullTarget">
                <join-column name="ONE_FALSE"/>
            </one-to-one>
            <embedded name="details"/>
        </attributes>
    </entity>
    <entity class="org.eclipse.persistence.jpa.test.basic.model.nonnull.NonnullTarget" access="FIELD">
        <table name="NNOPT_TARGET"/>
        <attributes>
            <id name="id"/>
            <basic name="label"/>
            <transient name="inverseOwner"/>
        </attributes>
    </entity>
</entity-mappings>
