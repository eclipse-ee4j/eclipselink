<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_4_0.xsd"
        version="4.0">
    <persistence-unit name="default-to-one-fetch-xml-lazy" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <class>org.eclipse.persistence.jpa.fetchdefaults.model.DefaultFetchOwner</class>
        <class>org.eclipse.persistence.jpa.fetchdefaults.model.DefaultFetchTarget</class>
        <class>org.eclipse.persistence.jpa.fetchdefaults.model.DefaultFetchPropertyOwner</class>
        <class>org.eclipse.persistence.jpa.fetchdefaults.model.DefaultFetchMappedSuperclass</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <default-to-one-fetch-type>LAZY</default-to-one-fetch-type>
    </persistence-unit>
    <persistence-unit name="default-to-one-fetch-xml-eager" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <class>org.eclipse.persistence.jpa.fetchdefaults.model.DefaultFetchOwner</class>
        <class>org.eclipse.persistence.jpa.fetchdefaults.model.DefaultFetchTarget</class>
        <class>org.eclipse.persistence.jpa.fetchdefaults.model.DefaultFetchPropertyOwner</class>
        <class>org.eclipse.persistence.jpa.fetchdefaults.model.DefaultFetchMappedSuperclass</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <default-to-one-fetch-type>EAGER</default-to-one-fetch-type>
    </persistence-unit>
    <persistence-unit name="default-to-one-fetch-xml-omitted" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <class>org.eclipse.persistence.jpa.fetchdefaults.model.DefaultFetchOwner</class>
        <class>org.eclipse.persistence.jpa.fetchdefaults.model.DefaultFetchTarget</class>
        <class>org.eclipse.persistence.jpa.fetchdefaults.model.DefaultFetchPropertyOwner</class>
        <class>org.eclipse.persistence.jpa.fetchdefaults.model.DefaultFetchMappedSuperclass</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
    </persistence-unit>
</persistence>
